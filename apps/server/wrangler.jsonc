// WebRA Worker: serves dist/ (website at /, game at /play/ behind the play
// gate) and the /api/* routes (docs/contracts.md, sections 4 and 6).
// Deployed by .github/workflows/deploy.yml.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webra",
  "account_id": "6a1cde1074a1925835edfca0f807efb5",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // AsyncLocalStorage (node:async_hooks) for the error report SDK
  // (@sentry/cloudflare, src/telemetry.js): it keeps each request's scope.
  "compatibility_flags": ["nodejs_als"],
  "routes": [{ "pattern": "webra.sherin.dev", "custom_domain": true }],
  // Only the custom domain serves the Worker: no workers.dev address and no
  // preview URLs (links in account mail point at SITE_ORIGIN in any case).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    // The Worker answers the API and gates the game: /play and /play/* are
    // served only to accounts that may play (src/playgate.js). Patterns
    // match the raw path; other spellings of game paths are redirected by
    // Static Assets to the canonical, gated path (docs/security.md).
    "run_worker_first": ["/api/*", "/play", "/play/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webra",
      "database_id": "51eb9902-c4dc-42fe-a6c5-4b83676ea053",
      "migrations_dir": "migrations"
    }
  ],
  // Replays kept in accounts (src/accounts/replays.js): gzip objects under
  // replays/<user id>/<replay id>, listed from D1 (account_replays). The
  // deploy workflow creates the bucket when it is missing (docs/deploy.md);
  // wrangler dev and the tests use a local stand-in.
  "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "webra-replays" }],
  // Daily retention job for accounts data (src/accounts/cron.js), replays included.
  "triggers": { "crons": ["17 3 * * *"] },
  // Discord OAuth client id (public). The secret DISCORD_CLIENT_SECRET is a
  // Worker secret set by the owner; without both, Discord sign-in is
  // unavailable. Account email (the send_email binding EMAIL and the variable
  // EMAIL_FROM) needs the Workers Paid plan, so it is not here: the deploy adds
  // both when the repository variable EMAIL_FROM is set (tools/email-config.mjs,
  // docs/deploy.md), and wrangler dev runs without email.
  // Error reports (src/telemetry.js, docs/security.md "Error reports"): off
  // here and so under wrangler dev; the deploy workflow sets the SENTRY_*
  // variables with `--var` from tools/sentry-config.mjs (the DSN is a
  // public client key, not a secret).
  // SITE_ORIGIN: where links in account mail point (src/accounts/email.js;
  // wrangler dev links to its own local address instead). EMAIL_DAILY_LIMIT:
  // the most account mails sent per UTC day, whoever asks (docs/deploy.md).
  "vars": {
    "SITE_ORIGIN": "https://webra.sherin.dev",
    "EMAIL_DAILY_LIMIT": "300",
    // PBKDF2 iterations for new password hashes (src/accounts/password.js):
    // the Workers Paid plan has the CPU room for the maximum, 100,000.
    "PASSWORD_ITERATIONS": "100000",
    "DISCORD_CLIENT_ID": "",
    "SENTRY_DSN": "",
    "SENTRY_ENVIRONMENT": "dev",
    "SENTRY_RELEASE": "",
    "SENTRY_TRACES_SAMPLE_RATE": "0.05"
  },
  // Per-IP burst limits for the sign-in endpoints without D1 writes
  // (src/accounts/context.js `burst`): 20 requests per minute per purpose and
  // address. The Worker falls back to D1 counters when the binding is absent.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
