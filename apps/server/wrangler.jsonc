// WebRA Worker: serves dist/ (website at /, game at /play/) and the /api/*
// routes (docs/contracts.md, sections 4 and 6). Deployed by .github/workflows/deploy.yml.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webra",
  "account_id": "6a1cde1074a1925835edfca0f807efb5",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "webra.sherin.dev", "custom_domain": true }],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webra",
      "database_id": "51eb9902-c4dc-42fe-a6c5-4b83676ea053",
      "migrations_dir": "migrations"
    }
  ],
  // Daily retention job for accounts data (src/accounts/cron.js).
  "triggers": { "crons": ["17 3 * * *"] },
  // Discord OAuth client id (public). The secret DISCORD_CLIENT_SECRET is a
  // Worker secret set by the owner; without both, Discord sign-in is
  // unavailable. Email sending (send_email) needs the Workers Paid plan and is
  // added later, see docs/deploy.md.
  "vars": { "DISCORD_CLIENT_ID": "" },
  // Per-IP burst limits for the sign-in endpoints without D1 writes
  // (src/accounts/context.js `burst`): 20 requests per minute per purpose and
  // address. The Worker falls back to D1 counters when the binding is absent.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
