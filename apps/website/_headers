# Security headers for every static file (Cloudflare Workers Static Assets).
# API responses set their own headers in apps/server/src/http.js.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://webra.sherin.dev; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The game is cross-origin isolated (COOP above plus COEP here), so its
# simulation worker can share render buffers with the page through
# SharedArrayBuffer (apps/game/js/sim). Everything the game loads is
# same-origin (see the CSP), so require-corp blocks nothing; the website
# pages do not need isolation.
/play
  Cross-Origin-Embedder-Policy: require-corp
/play/*
  Cross-Origin-Embedder-Policy: require-corp
