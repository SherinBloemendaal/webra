{
  "name": "webra",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "webra",
      "version": "0.2.0",
      "license": "GPL-3.0-or-later",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/game": {
      "name": "@webra/game",
      "version": "0.2.0",
      "license": "GPL-3.0-or-later",
      "dependencies": {
        "@webra/protocol": "0.2.0"
      }
    },
    "apps/server": {
      "name": "@webra/server",
      "version": "0.2.0",
      "license": "GPL-3.0-or-later",
      "dependencies": {
        "@webra/protocol": "0.2.0"
      }
    },
    "apps/website": {
      "name": "@webra/website",
      "version": "0.2.0",
      "license": "GPL-3.0-or-later"
    },
    "node_modules/@webra/game": {
      "resolved": "apps/game",
      "link": true
    },
    "node_modules/@webra/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@webra/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@webra/website": {
      "resolved": "apps/website",
      "link": true
    },
    "packages/protocol": {
      "name": "@webra/protocol",
      "version": "0.2.0",
      "license": "GPL-3.0-or-later"
    }
  }
}
